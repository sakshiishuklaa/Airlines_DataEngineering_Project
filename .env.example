# Copy to .env and fill locally. Never commit real credentials.
# Put AWS access keys in `aws configure --profile skyflow`, not in this file.

SKYFLOW_ENV=local
SKYFLOW_LOG_LEVEL=INFO

# Generator
SKYFLOW_CONFIG_PATH=config/generator.yaml
SKYFLOW_OUTPUT_ROOT=data/lake/raw
SKYFLOW_RANDOM_SEED=42

# --- Module 2: S3 landing (fill before the uploader) ---
AWS_REGION=us-east-1
AWS_PROFILE=skyflow
S3_LAKE_BUCKET=
S3_RAW_PREFIX=raw

# --- Later: Glue / lake zones ---
S3_PROCESSED_PREFIX=processed
S3_CURATED_PREFIX=curated
S3_REJECTED_PREFIX=rejected
GLUE_DATABASE=skyflow_catalog
GLUE_ROLE_ARN=
GLUE_CONNECTION_NAME=

# --- Warehouse: local Postgres first. Use RDS endpoint only if Glue JDBC. ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skyflow_dw
POSTGRES_USER=skyflow
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer
POSTGRES_SECRET_ARN=
